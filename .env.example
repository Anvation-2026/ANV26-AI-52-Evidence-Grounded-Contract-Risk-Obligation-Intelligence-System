# Default is SQLite for a simple local demo.
# To use MySQL, set USE_MYSQL=true and provide DB_USER/DB_PASSWORD/DB_HOST/DB_PORT/DB_NAME.
USE_MYSQL=false
DATA_DIR=./data
MAX_UPLOAD_BYTES=15728640

# Use a unique random value outside local development
AUTH_SECRET=replace-with-a-long-random-secret-before-deployment
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
